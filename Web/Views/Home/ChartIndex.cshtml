<script>
    // Severity Chart
    const ctx1 = document.getElementById('severityChart');
    new Chart(ctx1, {
      type: 'doughnut',
      data: {
        labels: ['Moderate', 'High', 'Low'],
        datasets: [{
          data: [5, 4, 6],
          backgroundColor: ['#f59e0b', '#ef4444', '#22c55e'],
          borderWidth: 0
        }]
      },
      options: {
        cutout: '70%',
         width: 180,          // custom width
    height: 180,
        plugins: { legend: { display: false } },
      }
    });

    // Status Chart
    const ctx2 = document.getElementById('statusChart');
    new Chart(ctx2, {
      type: 'doughnut',
      data: {
        labels: ['Submitted', 'Started', 'Validated', 'Completed', 'Dispatched', 'Cancelled'],
        datasets: [{
          data: [5, 2, 2, 2, 3, 1],
          backgroundColor: ['#ef4444', '#3b82f6', '#fbbf24', '#22c55e', '#f97316', '#6b7280'],
          borderWidth: 0
        }]
      },
      options: {
        cutout: '70%',
         width: 180,          // custom width
    height: 180,
        plugins: { legend: { display: false } },
      }
    });
</script>