                                            <li class="d-flex align-items-center justify-content-between InfoCount"> <div class="dot-name"><div class="legend-dot" style="background:#3b82f6"></div> Started</div><div class="count">2 (13%)</div></li>
                                            <li class="d-flex align-items-center justify-content-between InfoCount"> <div class="dot-name"><div class="legend-dot" style="background:#fbbf24"></div> Validated</div><div class="count">2 (13%)</div></li>
