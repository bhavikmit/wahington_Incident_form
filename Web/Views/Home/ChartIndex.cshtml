                                            <li class="d-flex align-items-center justify-content-between InfoCount"> <div class="dot-name"><div class="legend-dot" style="background:#f97316"></div> Dispatched</div><div class="count">3 (20%)</div></li>
                                            <li class="d-flex align-items-center justify-content-between InfoCount"> <div class="dot-name"><div class="legend-dot" style="background:#6b7280"></div> Cancelled</div><div class="count">1 (7%)</div></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            @* <div class="row">
                    <div class="col-md-6">
