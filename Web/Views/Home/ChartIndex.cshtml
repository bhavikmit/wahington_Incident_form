                                            <div class="chart-center">
                                                <div>15</div>
                                                <small>Total</small>
                                            </div>
                                        </div>
                                        <ul class="chart-legend p-0 mt-2">
                                            <li class="d-flex align-items-center justify-content-between InfoCount">
                                                <div class="dot-name">
                                                    <div class="legend-dot" style="background:#f59e0b"></div> Moderate
                                                </div>
                                                <div class="count">5 (33%)</div>
                                            </li>
                                            <li class="d-flex align-items-center justify-content-between InfoCount">
                                                <div class="dot-name">
                                                    <div class="legend-dot" style="background:#ef4444"></div> High
                                                </div>
                                                <div class="count">4 (27%)</div>
                                            </li>
                                            <li class="d-flex align-items-center justify-content-between InfoCount">
                                                <div class="dot-name">
                                                    <div class="legend-dot" style="background:#22c55e"></div> Low
                                                </div>
