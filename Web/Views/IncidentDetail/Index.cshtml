    }

    #validation textarea.form-control {
        border-radius: 6px;
        resize: none;
    }

    #validation .note-text {
        line-height: 1.6;
    }

    #validation .status-text {
        font-weight: 600;
    }
    /************Assessment*****************/
    #assessment .main-card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.1);
        padding: 20px;
        margin-top: 20px;
    }

    #assessment .section-title {
        font-weight: 600;
        font-size: 1rem;
        margin-top: 15px;
        border-bottom: 1px solid #e3e3e3;
        padding-bottom: 5px;
    }

    #assessment .table th {
        font-size: 0.9rem;
        font-weight: 600;
    }

    #assessment .table td {
        font-size: 0.9rem;
        vertical-align: middle;
    }

    #assessment .updates-box {
        background-color: #fff;
        border-radius: 8px;
