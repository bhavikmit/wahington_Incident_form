    #restoration .info-title ,
    #closeout .info-title {
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 5px;
        font-weight: 500;
    }

    #repair .info-value ,
    #restoration .info-value ,
    #closeout .info-value {
