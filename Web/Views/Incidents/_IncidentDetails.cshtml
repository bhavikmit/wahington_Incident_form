@using System.Web
@using ViewModels.Incident
@model IncidentViewModel


<div class="shadow-sm border border-gray-200 card-body InfoCard">
    <h6 class="fw-bold mb-3">Incident Details</h6>
    <div class="row">
        <label class="form-label">Type of Event<span class="text-danger">*</span></label>
        <div class="col-md-12">
            <div class="eventType">
                <div class="form-check form-check-inline eventCheck">
                    <input class="form-check-input" type="radio" id="asset" >
                    <label class="form-check-label" for="asset">sase</label>
                </div>
               
                
                @* @foreach (var item in Model.incidentDetails.EventTypes)
                {
                    <div class="mb-3 eventCheck">
                        <input type="checkbox" name="eventTypes.Id" id="@item.Value" class="form-check-input">
                        <label class="form-check-label" for="@item.Value">@item.Text</label>
                    </div>
                } *@

                @foreach (var et in Model.incidentDetails.EventTypes)
                {
                    var id = "eventType_" + et.Value;
                    var checkedAttr = Model.incidentDetails.EventTypeIds != null ? (Model.incidentDetails.EventTypeIds.Contains(et.Value) ? "checked" : "") : "";
                    <div class="mb-3 eventCheck">
                        <input name="eventTypes.Id" type="checkbox" class="form-check-input"
                               data-val="true" data-val-required="The Event Type field is required." @checkedAttr value="@et.Value" id="@id">
                        <label class="form-check-label" for="@id">@et.Text</label>
                    </div>
                }

            </div>
            <div class="col-md-12">
                <div class="mb-3">
                    <input type="checkbox" id="IsOtherEvent" class="form-check-input" asp-for="incidentDetails.IsOtherEvent">
                    <label class="form-check-label" asp-for="incidentDetails.IsOtherEvent">Other</label>
                </div>
                <div class="mb-3">
                    <input type="text" id="OtherEventDetail" class="form-control" asp-for="incidentDetails.OtherEventDetail">
                </div>
            </div>
        </div>



        <div class="d-flex justify-content-end gap-2 mt-3 addIncidentBtns">
            <button type="button" class="btn btnBack" id="backButtonToIncidentLoc">Back</button>
            <button type="button" class="btn btn-primary" id="nextToDescriptionIssue">Next</button>
        </div>
    </div>
</div>