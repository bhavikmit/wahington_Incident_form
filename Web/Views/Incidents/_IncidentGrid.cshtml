@using System.Web
@using Enums
@using ViewModels.Incident
@model IncidentViewModel

<table class="table align-middle text-left">
    <thead class="table-light">
        <tr>
            <th>Status</th>
            <th>Severity</th>
            <th>Date/Time</th>
            <th>Event Type</th>
            <th>Resources</th>
            <th>Asset Type</th>
            <th>Description</th>
            <th>Intersection</th>
            <th>Location</th>
            <th>ES Indicators</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>

        @if (Model.incidentGridViewModel.Count > 0)
        {
            @foreach (var item in Model.incidentGridViewModel)
            {
                <tr id="@item.Id">
                    <td class="status-submitted">
                        <div class="dropdown customTableDropdown">

                            @if (item.StatusLegend == StatusLegendEnum.Submitted.ToString())
                            {
                                <button class="btn status-submitted rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Submitted
                                </button>
                            }
                            else if (item.StatusLegend == StatusLegendEnum.Dispatched.ToString())
                            {
                                <button class="btn status-dispatched rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Dispatched
                                </button>
                            }
                            else if (item.StatusLegend == StatusLegendEnum.Started.ToString())
                            {
                                <button class="btn status-started rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Started
                                </button>
                            }
                            else if (item.StatusLegend == StatusLegendEnum.Completed.ToString())
                            {
                                <button class="btn status-completed rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Completed
                                </button>
                            }
                            else if (item.StatusLegend == StatusLegendEnum.Cancelled.ToString())
                            {
                                <button class="btn status-cancelled rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Cancelled
                                </button>
                            }
                            else
                            {
                                <button class="btn status-unknown rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Unknown
                                </button>
                            }
                            <ul class="dropdown-menu">
                                <li style="cursor: pointer" class="statusLegendli"><div class="dropdown-item text-submitted" data-id="Submitted">Submitted</div></li>
                                <li style="cursor: pointer" class="statusLegendli"><div class="dropdown-item text-dispatched" href="#" data-id="Dispatched">Dispatched</div></li>
                                <li style="cursor: pointer" class="statusLegendli"><div class="dropdown-item text-started" href="#" data-id="Started">Started</div></li>
                                <li style="cursor: pointer" class="statusLegendli"><div class="dropdown-item text-completed" href="#" data-id="Completed">Completed</div></li>
                                <li style="cursor: pointer" class="statusLegendli"><div class="dropdown-item text-cancelled" href="#" data-id="Cancelled">Cancelled</div></li>
                            </ul>
                        </div>
                    </td>
                    <td>
                        @if (item.Severity == SeverityEnum.Low.ToString())
                        {
                            <span class="badge rounded-pill badge-low px-3 py-2">Low</span>
                        }
                        else if (item.Severity == SeverityEnum.Moderate.ToString())
                        {
                            <span class="badge rounded-pill badge-medium px-3 py-2">Moderate</span>
                        }
                        else if (item.Severity == SeverityEnum.High.ToString())
                        {
                            <span class="badge rounded-pill badge-high px-3 py-2">High</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill badge-unknown px-3 py-2">Unknown</span>
                        }
                    </td>
                    <td>
                        <div class="date-time-sec">
                            <p class="date">@item.CallDate</p>
                            <p class="time">@item.CallTime</p>
                        </div>
                    </td>
                    <td style="text-wrap:auto">@item.EventTypeId</td>
                    <td>
                        <div class="event-type">
                            @item.RelationShipName
                        </div>
                    </td>
                    <td>
                        <div class="event-type">
                           @item.AssetId
                        </div>
                    </td>
                    <td>@item.DescriptionIssue</td>
                    <td>@item.Intersection</td>
                    <td>
                        <div class="map" style="text-wrap:auto">
                            <i class="fa fa-map-marker"></i>
                            @item.LocationAddress
                        </div>
                    </td>
                    
                    <td>@item.GasESIndicator</td>
                    <td>
                        <!-- Action Icons -->
                        @* <a href="#" class="btnIcon eyeIcon" title="View" data-bs-toggle="modal" data-bs-target="#viewIncidentModal"><i class="fa fa-eye"></i></a> *@
                        <a href="javascript:void(0);"
                           class="btnIcon eyeIcon view-incident"
                           data-id="@item.Id"
                           title="View">
                            <i class="fa fa-eye"></i>
                        </a>
                        <a href="javascript:void(0);"
                           class="btnIcon noteIcon note-incident"
                           title="Notes"
                           data-id="@item.Id">
                            <i class="fa fa-message"></i>
                        </a>

                        <a href="javascript:void(0);"
                           class="btnIcon historyIcon"
                           data-id="@item.Id"
                           title="History">
                            <i class="fa fa-repeat"></i>
                        </a>

                        <a href="#" class="btnIcon editIcon btnEditIncident" id="@item.Id" title="Edit"><i class="fa fa-pencil"></i></a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10" class="text-center">No records found.</td>
            </tr>
        }
    </tbody>
</table>