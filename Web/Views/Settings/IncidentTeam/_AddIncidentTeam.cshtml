@using ViewModels
@model IncidentTeamModifyViewModel

<form id="NewIncidentTeamForm">
    <div class="list-item addItem" id="saveIncidentTeamDiv">

        <input type="hidden" value="@Model.Id" name="Id" id="incidentTeam_@Model.Id" />

        <div class="input-container">
            <input type="text" placeholder="Enter incident team..." asp-for="Name" />
            <button class="btn check saveIncidentTeam"><i class="fa-solid fa-check"></i></button>
            <button class="btn cancel cancelIncidentTeam"><i class="fa-solid fa-xmark"></i></button>
        </div>
    </div>
</form>
