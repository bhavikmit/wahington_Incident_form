@using System.Web
@using ViewModels
@model List<RelationshipModifyViewModel>


@foreach (var relationship in Model)
{
    <div class="list-item">
        <span>@relationship.Name</span>
        <div class="actions">
            <i class="fa fa-pen edit"></i>
            <i class="fa fa-trash delete"></i>
        </div>
    </div>
}

