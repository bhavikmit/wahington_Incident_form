    }
    /*****************steps page design****************************/
    .titleofWorkflow p {
        font-size: 14px;
        margin-bottom: 0;
    }

    .titleofWorkflow h3 {
        line-height: normal;
    }
/*************************Stepper Design****************************/
    /* Step Navigation */

    .steps {
        background: #fff;
        padding: 1rem;
        border-radius: 12px;
        box-shadow: 0px 2px 6px rgba(0,0,0,0.05);
    }

    .steps .step {
        flex: 1;
        text-align: center;
        position: relative;
        color: #888;
        font-size: 0.9rem;
        transition: 0.3s ease;
    }

    .steps .step i {
        display: block;
        font-size:20px;
        margin-bottom: 0;
    }

    .steps .step.active {
        color: #f54e00;
        font-weight: 600;
    }

   .steps .step.active .step-icon{
       background:#f54e00;
        border: 2px solid #f54e00;
        color:#ffffff;
   }

    .steps .step.completed .step-icon{
        background: #198754;
        border: 2px solid #198754;
        color: #ffffff;
    }

    .steps .step.completed {
        color: #198754;
        font-weight: 600;
    }

    .steps .step::after {
        content: '';
        position: absolute;
        top: 20px;
        right: -50%;
        width: 100%;
        height: 2px;
        background: #d1d5db;
        z-index: 1;
    }

    .steps .step:last-child::after {
        display: none;
    }

    .steps .step.completed::after {
        background: #198754;
    }

    .step-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 2px solid #ccc;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto 8px auto;
        font-size: 18px;
        color: #6c757d;
        background: #fff;
        z-index: 999;
        position: relative;
    }

    .step-label {
        font-size: 14px;
        color: #6c757d;
    }

    .step.active .step-label {
        color: #f54e00;
        font-weight: 600;
    }

    .step.completed .step-label {
        color: #198754;
        font-weight: 600;
    }

    .btnNext {
        margin-left: auto;
    }
    /* Buttons */
